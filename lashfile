build:
	scons linkflags="-Wl,--whole-archive bin/obj/modules/libmodule_svg.linuxbsd.editor.x86_64.a -Wl,--no-whole-archive" debug_symbols=yes target=editor compiledb=yes

errs:
	if [[ -f errs ]]; then
		rm errs
	fi
	lash build 2> errs
	if [[ -f errs ]]; then
		wc -l errs
	fi

clean:
	if [[ -f errs ]]; then
		rm errs
	fi

show:
	batcat errs

inspect:
	gdb ./bin/voltaire.linuxbsd.editor.x86_64
