build:
	scons linkflags="-Wl,--whole-archive bin/obj/modules/libmodule_svg.linuxbsd.editor.x86_64.a -Wl,--allow-multiple-definition -Wl,--no-whole-archive" debug_symbols=yes target=editor compiledb=yes warnings=no

inspect:
	gdb ./bin/voltaire.linuxbsd.editor.x86_64

link:
	g++ -o bin/voltaire.linuxbsd.editor.x86_64 -static-libgcc -static-libstdc++ -O2 @bin/objects.txt -Lbin/build_deps/accesskit/lib/linux/x86_64/static -laccesskit -lrt -lpthread -ldl

remind:
	todo -l show

todo:
	todo -li

summary:
	if [[ -f errs2 ]]; then
		awk -F "undefined reference to \`" 'NF>1 {print $2}' errs2 | sed "s/'$//" | sort | uniq -c | sort -nr > errs3
	else
		sed -E '/.*x86_64\.o.*/d' errs > errs2
		lash summary
	fi
