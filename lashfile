build:
	scons -j 8 linkflags="-Wl,--whole-archive bin/obj/modules/libmodule_svg.linuxbsd.editor.x86_64.a -Wl,--allow-multiple-definition -Wl,--no-whole-archive" debug_symbols=yes target=editor compiledb=yes warnings=no

er:
	lash build 2> errs

err:
	lash link 2> errs

errs:
	lash build 2> errs
	lash link 2> errs

test:
	if [[ -f ./bin/voltaire.linuxbsd.editor.x86_64 ]]; then
		./bin/voltaire.linuxbsd.editor.x86_64 --display-driver wayland --rendering-driver vulkan
	else
		echo "Binary not built."
	fi

inspect:
	# gdb ./bin/voltaire.linuxbsd.editor.x86_64
	gdb --args ./bin/voltaire.linuxbsd.editor.x86_64 --display-driver wayland --rendering-driver vulkan

link:
	g++ -o bin/voltaire.linuxbsd.editor.x86_64 -static-libgcc -static-libstdc++ -O2 @bin/objects.txt -Lbin/build_deps/accesskit/lib/linux/x86_64/static -laccesskit -lrt -lpthread -ldl

remind:
	todo -l show

todo:
	todo -li

