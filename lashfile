build:
	ninja -C build -j 5

err:
	lash build 2> errs

testd:
	if [[ -f ./bin/x86_64/debug/voltaire ]]; then
		./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver dummy --accurate-breadcrumbs
	else
		echo "Binary not built."
	fi

testg:
	if [[ -f ./bin/x86_64/debug/voltaire ]]; then
		./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver opengl3 --accurate-breadcrumbs
	else
		echo "Binary not built."
	fi

testge:
	if [[ -f ./bin/x86_64/debug/voltaire ]]; then
		./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver opengl3_es --accurate-breadcrumbs
	else
		echo "Binary not built."
	fi

testv:
	if [[ -f ./bin/x86_64/debug/voltaire ]]; then
		./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver vulkan --accurate-breadcrumbs
	else
		echo "Binary not built."
	fi

test:
	lash testv

inspectd:
	gdb --args ./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver dummy --accurate-breadcrumbs

inspectg:
	gdb --args ./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver opengl3 --accurate-breadcrumbs

inspectge:
	gdb --args ./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver opengl3_es --accurate-breadcrumbs

inspectv:
	gdb --args ./bin/x86_64/debug/voltaire --display-driver wayland --rendering-driver vulkan --accurate-breadcrumbs

inspect:
	lash inspectv


