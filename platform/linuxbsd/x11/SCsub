#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

File = env.File

source_files = [
    File("display_server_x11.cpp"),
]

if env["use_sowrap"]:
    source_files.append(File("dynwrappers/xlib-so_wrap.c"))

if env["opengl3"]:
    env.Append(CPPDEFINES=["GLAD_GLX_NO_X11"])
    source_files.append([
        File("gl_manager_x11.cpp"),
        File("#thirdparty/glad/glx.c"),
    ])

Return("source_files")
