---
Language: Cpp
BasedOnStyle: LLVM

# --- Bracing & Style ---
# BreakBeforeBraces: Stroustrup
# InsertBraces: true
# AllowShortIfStatementsOnASingleLine: Always
# AllowShortLoopsOnASingleLine: true
# AllowShortBlocksOnASingleLine: Always
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterFunction: true
  AfterExternBlock: true
  AfterNamespace: true
  AfterEnum: true
  # This keeps the braces attached for conditionals and loops inside functions
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false

# --- Indentation (Go-Style Tabs) ---
# UseTab: Always converts all indentation to tabs
UseTab: Always
TabWidth: 4
IndentWidth: 4
AccessModifierOffset: -4
# Prevents mixing spaces for alignment after a tabbed indent
AlignAfterOpenBracket: DontAlign

# --- Pointer & Alignment ---
PointerAlignment: Left
DerivePointerAlignment: false

# --- Include Sorting ---
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^<.*'
    Priority:        1
    SortPriority:    1
  - Regex:           '^".*'
    Priority:        1
    SortPriority:    2

# --- Empty Line Management ---
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
SeparateDefinitionBlocks: Always

# --- General Cleanliness ---
ColumnLimit: 100
Standard: Latest
...
